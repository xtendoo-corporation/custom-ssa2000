<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_self_billing_ssa2000" model="ir.actions.report">
        <field name="name">Autofactura</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ssa2000_document_format.report_self_billing_document</field>
        <field name="report_file">ssa2000_document_format.report_self_billing_document</field>
        <field name="print_report_name">'Autofactura - %s' % (object.name or 'Borrador')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="ssa2000_document_format.paperformat_self_billing_ssa2000"/>
    </record>

    <template id="report_self_billing_document">
        <t t-call="web.html_container">
            <t t-foreach="docs.filtered(lambda m: m.move_type in ('in_invoice', 'in_refund'))" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="ssa_currency" t-value="o.currency_id"/>
                    <t t-set="ssa_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"/>
                    <t t-set="ssa_withholding" t-value="o.line_ids.filtered(lambda l: l.tax_line_id and l.tax_line_id.amount &lt; 0)"/>
                    <div class="page pt-2">
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>PROVEEDOR</strong>
                                <div t-out="o.partner_id.display_name"/>
                                <div t-if="o.partner_id.vat" t-out="o.partner_id.vat"/>
                                <div t-out="o.partner_id.street"/>
                                <div>
                                    <span t-out="o.partner_id.zip"/> <span t-out="o.partner_id.city"/>
                                </div>
                                <div t-if="o.partner_id.state_id" t-out="o.partner_id.state_id.name"/>
                            </div>
                            <div class="col-3" t-if="o.partner_id.ref">
                                <strong>Cód. proveedor</strong>
                                <div t-out="o.partner_id.ref"/>
                            </div>
                            <div class="col-3">
                                <strong>CLIENTE</strong>
                                <div t-out="o.company_id.name"/>
                                <div t-if="o.company_id.vat" t-out="o.company_id.vat"/>
                                <div t-if="o.company_id.street" t-out="o.company_id.street"/>
                                <div t-if="o.company_id.street2" t-out="o.company_id.street2"/>
                                <div>
                                    <span t-out="o.company_id.zip"/> <span t-out="o.company_id.city"/>
                                </div>
                                <div t-if="o.company_id.state_id" t-out="o.company_id.state_id.name"/>
                            </div>
                        </div>
                        <h2>
                            <span t-if="o.move_type == 'in_refund'">AUTOFACTURA RECTIFICATIVA</span>
                            <span t-else="">FACTURA</span>
                            <span t-out="o.ref or o.name"/>
                        </h2>
                        <div class="row mb-3">
                            <div class="col-3">
                                <strong>Fecha</strong>
                                <div t-field="o.invoice_date"/>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table" name="ssa_self_billing_table">
                            <thead>
                                <tr>
                                    <th class="px-2">Código</th>
                                    <th class="px-2">Descripción</th>
                                    <th class="px-2 text-end">Cantidad</th>
                                    <th class="px-2 text-end">Coste</th>
                                    <th class="px-2 text-end">% IVA</th>
                                    <th class="px-2 text-end">IVA</th>
                                    <th class="px-2 text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="ssa_lines" t-as="line">
                                    <t t-set="ssa_vat_pct" t-value="sum(line.tax_ids.filtered(lambda t: t.amount &gt; 0).mapped('amount'))"/>
                                    <t t-set="ssa_vat_amount" t-value="line.price_subtotal * ssa_vat_pct / 100.0"/>
                                    <td class="px-2"><span t-out="line.product_id.default_code"/></td>
                                    <td class="px-2"><span t-out="line.name"/></td>
                                    <td class="px-2 text-end"><span t-out="line.quantity" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                    <td class="px-2 text-end"><span t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/></td>
                                    <td class="px-2 text-end"><span t-out="ssa_vat_pct" t-options="{'widget': 'float', 'precision': 2}"/>%</td>
                                    <td class="px-2 text-end"><span t-out="ssa_vat_amount" t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/></td>
                                    <td class="px-2 text-end"><span t-out="line.price_subtotal + ssa_vat_amount" t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-7 ms-auto">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Total bruto</td>
                                        <td class="text-end"><span t-out="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Base imponible</td>
                                        <td class="text-end"><span t-out="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/></td>
                                    </tr>
                                    <tr t-foreach="o.line_ids.filtered(lambda l: l.tax_line_id and l.tax_line_id.amount &gt; 0)" t-as="vat_line">
                                        <td>I.V.A. <span t-out="vat_line.tax_line_id.amount" t-options="{'widget': 'float', 'precision': 2}"/>%</td>
                                        <td class="text-end"><span t-out="abs(vat_line.balance)" t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/></td>
                                    </tr>
                                    <t t-set="ssa_vat_rate" t-value="sum(o.line_ids.filtered(lambda l: l.tax_line_id and l.tax_line_id.amount &gt; 0).mapped('tax_line_id.amount'))"/>
                                    <tr t-foreach="ssa_withholding" t-as="wh_line">
                                        <t t-set="ssa_on_vat" t-value="'IVA' in wh_line.tax_line_id.name"/>
                                        <td>
                                            I.R.P.F.
                                            <span t-out="abs(wh_line.tax_line_id.amount) / (1 + ssa_vat_rate / 100.0) if ssa_on_vat else abs(wh_line.tax_line_id.amount)"
                                                  t-options="{'widget': 'float', 'precision': 2}"/>%
                                            <small t-if="ssa_on_vat" class="text-muted">(s/ base + IVA)</small>
                                        </td>
                                        <td class="text-end">-<span t-out="abs(wh_line.balance)" t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/></td>
                                    </tr>
                                    <tr class="border-black o_total">
                                        <td><strong>Total factura</strong></td>
                                        <td class="text-end"><strong t-out="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <p t-if="o.invoice_payment_term_id or o.payment_reference">
                            <strong>Forma de pago:</strong>
                            <span t-out="o.payment_reference or o.invoice_payment_term_id.name"/>
                        </p>
                        <p t-if="not is_html_empty(o.narration)">
                            <span t-field="o.narration"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
