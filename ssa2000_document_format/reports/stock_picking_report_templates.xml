<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_ssa2000" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.company_id.ssa_registry_code" class="col col-3 mw-100 mb-2" name="ssa_registry">
                <strong>Registro Junta de Andalucía</strong>
                <div class="m-0" t-out="o.company_id.ssa_registry_code"/>
            </div>
            <div t-if="o.partner_id.commercial_partner_id.ref" class="col col-3 mw-100 mb-2" name="ssa_partner_ref">
                <strong>Cód. cliente</strong>
                <div class="m-0" t-out="o.partner_id.commercial_partner_id.ref"/>
            </div>
        </xpath>

        <!-- Un único número: el de albarán, que coincide con el número de pedido -->
        <xpath expr="//div[@name='div_origin']" position="replace"/>
        <xpath expr="//h2/span[@t-field='o.name']" position="replace">
            <span t-out="o.origin or o.name"/>
        </xpath>

        <!-- Separa las direcciones de la cabecera de la empresa (mismo margen en ambas columnas) -->
        <xpath expr="//div[@name='div_outgoing_address']" position="attributes">
            <attribute name="class" add="pt-4" separator=" "/>
        </xpath>
        <xpath expr="//div[@name='div_incoming_address']" position="attributes">
            <attribute name="class" add="pt-4" separator=" "/>
        </xpath>

        <!-- Origen y transporte: dos filas de tres columnas (wkhtmltopdf no soporta flex-wrap) -->
        <xpath expr="//div[@id='informations']" position="after">
            <div class="row mb-2" name="ssa_origin_transport_1" t-if="o.ssa_origin_supplier_id.display_name or o.ssa_origin_farm or o.ssa_origin_lot">
                <div class="col-4" name="ssa_origin_supplier">
                    <t t-if="o.ssa_origin_supplier_id.display_name">
                        <strong>Proveedor origen mercancía</strong>
                        <div class="m-0" t-out="o.ssa_origin_supplier_id.display_name"/>
                    </t>
                </div>
                <div class="col-4" name="ssa_origin_farm">
                    <t t-if="o.ssa_origin_farm">
                        <strong>Desde la finca</strong>
                        <div class="m-0" t-out="o.ssa_origin_farm"/>
                    </t>
                </div>
                <div class="col-4" name="ssa_lot">
                    <t t-if="o.ssa_origin_lot">
                        <strong>Lote de origen</strong>
                        <div class="m-0" t-out="o.ssa_origin_lot"/>
                    </t>
                </div>
            </div>
            <div class="row mb-2" name="ssa_origin_transport_2" t-if="o.ssa_carrier_name or o.ssa_vehicle_plate or o.ssa_trip_number">
                <div class="col-4" name="ssa_carrier">
                    <t t-if="o.ssa_carrier_name">
                        <strong>Transportista</strong>
                        <div class="m-0" t-out="o.ssa_carrier_name"/>
                    </t>
                </div>
                <div class="col-4" name="ssa_plate">
                    <t t-if="o.ssa_vehicle_plate">
                        <strong>Matrícula</strong>
                        <div class="m-0" t-out="o.ssa_vehicle_plate"/>
                    </t>
                </div>
                <div class="col-4" name="ssa_trip">
                    <t t-if="o.ssa_trip_number">
                        <strong>Núm. viaje</strong>
                        <div class="m-0" t-out="o.ssa_trip_number"/>
                    </t>
                </div>
            </div>
        </xpath>

        <!-- Se desactivan las dos tablas estándar y se pinta una propia -->
        <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']" position="attributes">
            <attribute name="t-elif">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']" position="after">
            <t t-set="ssa_moves" t-value="o.move_ids.filtered(lambda m: m.quantity or m.product_uom_qty)"/>
            <t t-set="ssa_has_weights" t-value="any(m.ssa_gross_weight or m.ssa_tare_weight for m in ssa_moves)"/>
            <t t-set="ssa_has_prices" t-value="any(m.sale_line_id for m in ssa_moves)"/>
            <t t-set="ssa_has_lots" t-value="any(ssa_moves.move_line_ids.lot_id)"/>
            <table class="table table-sm o_main_table" name="ssa_move_table">
                <thead>
                    <tr>
                        <th name="th_ssa_code" class="px-2">Código</th>
                        <th name="th_ssa_product" class="px-2">Descripción</th>
                        <th name="th_ssa_lot" t-if="ssa_has_lots" class="px-2">Lote</th>
                        <th name="th_ssa_gross" class="px-2 text-end" t-if="ssa_has_weights">Tn. bruto</th>
                        <th name="th_ssa_tare" class="px-2 text-end" t-if="ssa_has_weights">Tn. tara</th>
                        <th name="th_ssa_qty" class="px-2 text-end">
                            <t t-if="ssa_has_weights">Tn. neto</t>
                            <t t-else="">Cantidad</t>
                        </th>
                        <th name="th_ssa_price" class="px-2 text-end" t-if="ssa_has_prices">Precio</th>
                        <th name="th_ssa_amount" class="px-2 text-end" t-if="ssa_has_prices">Importe</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="ssa_moves" t-as="move">
                        <td class="px-2"><span t-field="move.product_id.default_code"/></td>
                        <td class="px-2">
                            <span t-out="move.description_picking or move.product_id.name"
                                  t-options="{'widget': 'text'}"/>
                        </td>
                        <td t-if="ssa_has_lots" class="px-2"><span t-out="', '.join(move.move_line_ids.lot_id.mapped('name'))"/></td>
                        <t t-if="ssa_has_weights">
                            <td class="px-2 text-end"><span t-field="move.ssa_gross_weight"/></td>
                            <td class="px-2 text-end"><span t-field="move.ssa_tare_weight"/></td>
                        </t>
                        <td class="px-2 text-end">
                            <t t-if="ssa_has_weights"><span t-field="move.ssa_net_weight"/></t>
                            <t t-else="">
                                <span t-out="move.quantity or move.product_uom_qty" t-options="{'widget': 'float', 'precision': 2}"/>
                                <span t-field="move.product_uom" groups="uom.group_uom"/>
                            </t>
                        </td>
                        <t t-if="ssa_has_prices">
                            <td class="px-2 text-end"><span t-if="move.sale_line_id" t-field="move.ssa_price_unit"/></td>
                            <td class="px-2 text-end"><span t-if="move.sale_line_id" t-field="move.ssa_price_subtotal"/></td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>

    <!-- Total del albarán -->
    <template id="report_delivery_document_totals_ssa2000" inherit_id="stock.report_delivery_document"
              priority="20">
        <xpath expr="//table[@name='ssa_move_table']" position="after">
            <div class="row" t-if="o.move_ids.filtered('sale_line_id')">
                <div class="col-5 ms-auto">
                    <t t-set="ssa_currency" t-value="o.move_ids.filtered('sale_line_id')[:1].ssa_currency_id"/>
                    <table class="table table-sm">
                        <tr class="border-black o_total">
                            <td><strong>Total albarán</strong></td>
                            <td class="text-end">
                                <strong t-out="sum(o.move_ids.mapped('ssa_price_subtotal'))"
                                        t-options="{'widget': 'monetary', 'display_currency': ssa_currency}"/>
                            </td>
                        </tr>
                    </table>
                    <div class="text-muted small text-end">IVA no incluido</div>
                </div>
            </div>
            <div t-if="not is_html_empty(o.note)" name="ssa_observations" class="mb-3">
                <strong>Observaciones:</strong>
                <span t-field="o.note"/>
            </div>
        </xpath>
    </template>
</odoo>
