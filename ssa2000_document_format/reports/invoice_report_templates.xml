<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_ssa2000" inherit_id="account.report_invoice_document">
        <!-- Tipos de IVA sin la etiqueta interna (4% B, 21% S...) -->
        <xpath expr="//span[@id='line_tax_ids']" position="replace">
            <span id="line_tax_ids" t-if="not hide_prices"
                  t-out="', '.join('%s%%' % ('%g' % t.amount) for t in line.tax_ids) if all(t.amount_type == 'percent' for t in line.tax_ids) else taxes"/>
        </xpath>

        <!-- Albarán(es) de origen sobre la descripción de cada línea -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
            <t t-set="ssa_pickings" t-value="line._ssa_get_pickings()"/>
            <div t-if="ssa_pickings">
                <t t-foreach="ssa_pickings" t-as="ssa_picking">
                    Albarán núm. <span t-out="ssa_picking.name"/>
                    de fecha <span t-out="ssa_picking.date_done" t-options="{'widget': 'date'}"/>
                    <t t-if="not ssa_picking_last">·</t>
                </t>
            </div>
            <t t-set="ssa_w" t-value="line._ssa_get_weights()"/>
            <div t-if="ssa_w['has_weights']">
                Tn. bruto <span t-out="ssa_w['gross']" t-options="{'widget': 'float', 'precision': 3}"/>
                · Tn. tara <span t-out="ssa_w['tare']" t-options="{'widget': 'float', 'precision': 3}"/>
                · Tn. neto <span t-out="ssa_w['net']" t-options="{'widget': 'float', 'precision': 3}"/>
            </div>
            <div t-if="ssa_w['lots']">
                Lote: <span t-out="', '.join(ssa_w['lots'])"/>
            </div>
        </xpath>
    </template>
</odoo>
