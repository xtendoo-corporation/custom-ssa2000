<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_ssa2000" inherit_id="account.report_invoice_document">
        <!-- Registro de la empresa junto al resto de datos de cabecera -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" t-if="o.company_id.ssa_registry_code" name="ssa_registry">
                <strong>Registro Junta de Andalucía</strong>
                <div t-out="o.company_id.ssa_registry_code"/>
            </div>
        </xpath>

        <!-- Albarán(es) de origen sobre la descripción de cada línea -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
            <t t-set="ssa_pickings" t-value="line._ssa_get_pickings()"/>
            <div t-if="ssa_pickings">
                <t t-foreach="ssa_pickings" t-as="ssa_picking">
                    Albarán núm. <span t-out="ssa_picking.name"/>
                    de fecha <span t-out="ssa_picking.date_done" t-options="{'widget': 'date'}"/>
                    <t t-if="not ssa_picking_last">·</t>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
