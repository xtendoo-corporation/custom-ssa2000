<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Registro de la Junta de Andalucía recuadrado arriba a la derecha (albaranes y facturas de venta) -->
    <template id="external_layout_standard_registry_ssa2000" inherit_id="web.external_layout_standard">
        <xpath expr="//div[hasclass('justify-content-between')]" position="inside">
            <div t-if="o and company.ssa_registry_code
                       and (o._name == 'stock.picking' or (o._name == 'account.move' and o.move_type in ('out_invoice', 'out_refund')))"
                 class="border border-dark px-3 py-1 text-center ms-auto" name="ssa_registry_box">
                <div>Registro</div>
                <div>Junta de Andalucía</div>
                <strong t-out="company.ssa_registry_code"/>
            </div>
        </xpath>
    </template>

    <!-- Datos de la compañía a todo el ancho de la cabecera, para que los teléfonos no salten de línea -->
    <template id="external_layout_standard_wide_header_ssa2000" inherit_id="web.external_layout_standard">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="style">width: 100%; max-width: 100%; flex: 0 0 100%;</attribute>
        </xpath>
    </template>

    <!-- Autofactura: sin cabecera (ni logo ni datos de SSA); SSA figura en el bloque CLIENTE -->
    <template id="external_layout_standard_self_billing_ssa2000" inherit_id="web.external_layout_standard">
        <xpath expr="//div[@name='company_address']/../.." position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move' and o.move_type in ('in_invoice', 'in_refund'))</attribute>
        </xpath>
    </template>

    <!-- El CIF ya figura en los datos de la compañía de la cabecera: se oculta la línea de NIF del layout -->
    <template id="external_layout_standard_vat_ssa2000" inherit_id="web.external_layout_standard">
        <xpath expr="//ul[@name='company_address_list']/li[@t-if='not forced_vat']" position="replace"/>
        <xpath expr="//ul[@name='company_address_list']/li[@t-else=''][.//span[@t-esc='forced_vat']]" position="replace"/>
    </template>

    <!-- Aspecto con cajas, bordes y cabeceras sombreadas, como los modelos del cliente -->
    <template id="external_layout_standard_boxed_ssa2000" inherit_id="web.external_layout_standard">
        <xpath expr="//t[@t-call='web.address_layout']" position="before">
            <style type="text/css">
                table[name='ssa_move_table'],
                table[name='invoice_line_table'],
                table[name='ssa_self_billing_table'] {
                    border: 1px solid #000 !important;
                    border-collapse: collapse !important;
                }
                table[name='ssa_move_table'] thead th,
                table[name='invoice_line_table'] thead th,
                table[name='ssa_self_billing_table'] thead th {
                    background-color: #e6e6e6 !important;
                    border: 1px solid #000 !important;
                    color: #000 !important;
                    font-weight: bold !important;
                    padding: 4px 6px !important;
                }
                table[name='ssa_move_table'] tbody td,
                table[name='invoice_line_table'] tbody td,
                table[name='ssa_self_billing_table'] tbody td {
                    border-left: 1px solid #000 !important;
                    border-right: 1px solid #000 !important;
                    border-top: 0 !important;
                    padding: 4px 6px !important;
                }
                #total table, div[name='ssa_totals'] table {
                    border: 1px solid #000 !important;
                    border-collapse: collapse !important;
                }
                #total table td, div[name='ssa_totals'] table td {
                    border: 1px solid #999 !important;
                    padding: 3px 6px !important;
                }
                div[name='div_outgoing_address'], div[name='address'] address {
                    border: 1px solid #000;
                    border-radius: 6px;
                    padding: 8px 10px;
                }
                div[name='div_outgoing_address'] address {
                    border: 0 !important;
                    padding: 0 !important;
                }
                table[name='invoice_line_table'] thead th[name='th_description'] {
                    width: 30% !important;
                }
                div[name='comment'] {
                    clear: both !important;
                    margin-top: 14px !important;
                }
                div[name='ssa_observations'], div[name='comment'] {
                    border: 1px solid #000;
                    padding: 6px 8px;
                    min-height: 50px;
                }
            </style>
        </xpath>
    </template>

    <!-- En albaranes se imprime el pie específico de albarán (el de la compañía habla de "factura") -->
    <template id="external_layout_standard_ssa2000" inherit_id="web.external_layout_standard">
        <xpath expr="//div[hasclass('o_footer_content')]/div[@t-field='company.report_footer']" position="replace">
            <!-- Autofactura: las observaciones de pie son solo para ventas -->
            <div t-if="o and o._name == 'account.move' and o.move_type in ('in_invoice', 'in_refund')"
                 class="flex-grow-1 me-2"/>
            <t t-elif="o and o._name == 'stock.picking'">
                <div t-if="not is_html_empty(company.ssa_delivery_footer)"
                     class="flex-grow-1 text-start me-2" t-field="company.ssa_delivery_footer"/>
                <div t-else="" class="flex-grow-1 text-start me-2">
                    <p>* La posesión del presente albarán no presupone el pago de la mercancía. Su pago se acredita por abono bancario o por recibo de caja.</p>
                    <p>** Inscrita en el registro Mercantil de Sevilla con fecha 3 de Marzo de 1997 folio 71 del tomo 2477 de SOC, Hoja SE-28949</p>
                </div>
            </t>
            <div t-else="" class="flex-grow-1 text-start me-2">
                <t t-if="o and o._name == 'account.move' and o.move_type in ('out_invoice', 'out_refund')
                         and (o.partner_bank_id or company.partner_id.bank_ids)">
                    <t t-set="ssa_bank" t-value="o.partner_bank_id or company.partner_id.bank_ids[:1]"/>
                    <p><strong>** Forma de pago:</strong> Transferencia a cuenta
                        <span t-out="ssa_bank.bank_id.name"/> <span t-out="ssa_bank.acc_number"/></p>
                </t>
                <div t-field="company.report_footer"/>
            </div>
        </xpath>
    </template>
</odoo>
