<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Autofactura: margen superior reducido porque no lleva cabecera -->
    <record id="paperformat_self_billing_ssa2000" model="report.paperformat">
        <field name="name">A4 - autofactura SSA2000</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">15</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <!-- Pack Canarias: sin cabecera ni pie del layout, la factura lleva el suyo en el cuerpo -->
    <record id="paperformat_canarias_ssa2000" model="report.paperformat">
        <field name="name">A4 - pack Canarias SSA2000</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
