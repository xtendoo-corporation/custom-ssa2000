<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_ssa2000" model="ir.ui.view">
        <field name="name">stock.picking.form.ssa2000</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="ssa_gross_weight" column_invisible="parent.ssa_weight_mode != 'gross_tare'"/>
                <field name="ssa_tare_weight" column_invisible="parent.ssa_weight_mode != 'gross_tare'"/>
                <field name="ssa_net_weight" column_invisible="parent.ssa_weight_mode != 'gross_tare'"/>
                <field name="ssa_units"/>
            </xpath>
            <field name="origin" position="after">
                <field name="ssa_weight_mode"/>
                <field name="ssa_is_canarias"/>
            </field>
            <xpath expr="//header" position="inside">
                <button name="action_ssa_open_canarias" type="object" string="Datos Canarias"
                        invisible="not ssa_is_canarias"/>
            </xpath>
            <xpath expr="//page[@name='operations']" position="after">
                <page string="Origen y transporte" name="ssa_transport">
                    <group>
                        <group name="ssa_origin">
                            <field name="ssa_origin_supplier_id"/>
                            <field name="ssa_origin_farm"/>
                            <field name="ssa_origin_lot"/>
                        </group>
                        <group name="ssa_carrier">
                            <field name="ssa_carrier_name"/>
                            <field name="ssa_vehicle_plate"/>
                            <field name="ssa_trip_number"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_picking_canarias_form_ssa2000" model="ir.ui.view">
        <field name="name">stock.picking.canarias.ssa2000</field>
        <field name="model">stock.picking</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Datos de envío a Canarias" create="false" delete="false">
                <group>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="ssa_is_canarias" invisible="1"/>
                    </group>
                    <group>
                        <field name="ssa_invoice_number"/>
                        <field name="ssa_invoice_date"/>
                    </group>
                </group>
                <field name="ssa_canarias_line_ids">
                    <list editable="bottom" create="false">
                        <field name="product_id" readonly="1"/>
                        <field name="units"/>
                        <field name="net_kg"/>
                        <field name="container"/>
                        <field name="seal"/>
                        <field name="lot"/>
                        <field name="destination"/>
                    </list>
                </field>
                <footer>
                    <button name="action_ssa_print_canarias" type="object" string="Imprimir pack Canarias"
                            class="btn-primary"/>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
