<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_ssa2000" model="ir.ui.view">
        <field name="name">product.template.form.ssa2000</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Canarias" name="ssa_canarias">
                    <group>
                        <field name="ssa_stat_code"/>
                        <field name="ssa_goods_description"/>
                        <field name="ssa_botanical_name"/>
                        <field name="ssa_package_form"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
